{
  "AlarmName": "dr-automator-lambda-duration",
  "AlarmDescription": "Lambda execution duration is too high",
  "Namespace": "AWS/Lambda",
  "MetricName": "Duration",
  "Dimensions": [
    {
      "Name": "FunctionName",
      "Value": "dr-automator-restore-db"
    }
  ],
  "Statistic": "Average",
  "Period": 300,
  "EvaluationPeriods": 1,
  "Threshold": 60000,
  "ComparisonOperator": "GreaterThanThreshold",
  "TreatMissingData": "notBreaching"
}