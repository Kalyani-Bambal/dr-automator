{
  "AlarmName": "dr-automator-lambda-errors",
  "AlarmDescription": "Alarm when Restore DB Lambda reports errors",
  "Namespace": "AWS/Lambda",
  "MetricName": "Errors",
  "Dimensions": [
    {
      "Name": "FunctionName",
      "Value": "dr-automator-restore-db"
    }
  ],
  "Statistic": "Sum",
  "Period": 300,
  "EvaluationPeriods": 1,
  "Threshold": 1,
  "ComparisonOperator": "GreaterThanOrEqualToThreshold",
  "TreatMissingData": "notBreaching"
}